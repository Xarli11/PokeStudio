{
  "name": "@pokestudio/pokemon-data",
  "private": true,
  "version": "0.0.0",
  "description": "PokeStudio Pokémon reference data: full ingestion pipeline (fetch/cache -> normalize -> validate -> persist) and normalized types. Not a runtime PokéAPI client.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "tsx scripts/ingest.ts",
    "audit": "tsx scripts/audit.ts",
    "clean": "rm -rf dist .cache"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "@pokestudio/config": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
