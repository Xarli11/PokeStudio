    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pokemon-showdown": "0.11.11"
  },
  "devDependencies": {
    "@pokestudio/config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
