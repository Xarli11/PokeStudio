{
  "name": "@pokestudio/battle-engine",
  "private": true,
  "version": "0.0.0",
  "description": "PokeStudio authoritative battle-domain API over the Pokémon Showdown simulator (ADR-0003, ADR-0015). Node server-side runtime. UI and application code must not import pokemon-showdown directly.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
