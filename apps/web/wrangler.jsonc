{
  "$schema": "node_modules/wrangler/config-schema.json",
  // PokeLab web app on Cloudflare Workers (ADR-0005) via @opennextjs/cloudflare.
  // DEV/staging only — no custom domain, no production routes configured yet.
  // "name" must match the actual deployed Worker (dashboard/Workers Builds git
  // integration owns the real target, not this file) — verified via
  // `wrangler deployments list --name pokestudio` against every deploy since
  // 2026-09-09; the Worker was never actually named pokestudio-web-dev despite
  // that being this field's value since the file was introduced, which is why
  // `wrangler tail pokestudio-web-dev` failed with Cloudflare error 10007.
  // Renamed from "pokestudio": Cloudflare cannot rename a Worker, so "pokelab" is a new Worker
  // (docs/engineering/RENAME_POKELAB.md). Keep in sync with scripts/ci/targets.json.
  "name": "pokelab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Server-side Supabase access uses NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
  // (apps/web/src/lib/pokemon-database.ts) — set as Worker environment variables/secrets in the
  // Cloudflare dashboard (or `wrangler secret put`) for the deployed Worker, never committed here.
  // SUPABASE_SECRET_KEY must never be configured on this Worker — species/form reference data is
  // public-read, so the publishable key is sufficient (docs/engineering/DATABASE.md "Supabase API keys").
}
