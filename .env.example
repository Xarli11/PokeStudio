# PokeStudio environment variables — copy to .env.local and fill in real values.
# Never commit an actual .env / .env.local file (SECURITY.md).
#
# Supabase issues two key types (DATABASE.md "Supabase API keys"):
#   - publishable key (sb_publishable_...) — safe in browser code, RLS-governed.
#   - secret key (sb_secret_...) — server-only, bypasses RLS. Never expose to the client bundle.
# `supabase start` prints both for local dev; a Supabase Cloud project's API settings page does too.

# --- Supabase (client-safe — bundled into apps/web) ---
# These two are also what the Cloudflare Worker deployment needs (set them there
# as Worker environment variables, never committed) — see README.md "Cloudflare Workers".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (tooling/ingestion only — packages/database, packages/pokemon-data;
#     never bundled into the browser. Same project as above; kept as separate,
#     non-NEXT_PUBLIC_-prefixed variables so tooling can target a different
#     environment, e.g. a remote dev project, without touching apps/web's config.) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Sentry (OBSERVABILITY.md) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- AI providers (server-only; adapters live behind packages/ai when it exists) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
