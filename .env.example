# PokeStudio environment variables — copy to .env.local and fill in real values.
# Never commit an actual .env / .env.local file (SECURITY.md).

# --- Supabase (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — never expose to the client bundle) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry (OBSERVABILITY.md) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- AI providers (server-only; adapters live behind packages/ai when it exists) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
