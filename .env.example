# PokeLab environment variables — copy to .env.local and fill in real values.
# Never commit an actual .env / .env.local file (docs/engineering/SECURITY.md).
#
# Local development targets the Raspberry Pi self-hosted Supabase instance
# (192.168.1.236), never a Mac-local Supabase/Docker stack — see CLAUDE.md §21
# "Local Development Database — Source of Truth". Supabase Cloud is only for
# the deployed Cloudflare Worker DEV environment (docs/engineering/DATABASE.md).
#
# Supabase issues two key types (docs/engineering/DATABASE.md "Supabase API keys"):
#   - publishable key (sb_publishable_...) — safe in browser code, RLS-governed.
#   - secret key (sb_secret_...) — server-only, bypasses RLS. Never expose to the client bundle.
# For the Pi, both live in its own stack .env (/home/xarli11/supabase-pokestudio/.env,
# on the Pi itself — not in this repo) or Supabase Studio's API settings.

# --- Supabase (client-safe — bundled into apps/web) ---
# These two are also what the Cloudflare Worker deployment needs when targeting
# Supabase Cloud (set them there as Worker environment variables, never committed) —
# see README.md "Cloudflare Workers". For local dev, point these at the Pi:
#   NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.236:8002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (tooling/ingestion only — packages/database, packages/pokemon-data;
#     never bundled into the browser. Kept as separate, non-NEXT_PUBLIC_-prefixed
#     variables so tooling can target a different environment than apps/web without
#     touching its config. For local dev, point SUPABASE_URL at the Pi's API gateway:
#       SUPABASE_URL=http://192.168.1.236:8002) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Raspberry Pi direct Postgres (migrations/DB admin only — scripts/db-pi-*.sh,
#     `pnpm db:pi:check` / `db:pi:migrate` / `db:pi:types`). Never used by apps/web
#     or the ingestion pipeline — those go through the API gateway above.
#     postgres://postgres:<password>@192.168.1.236:5434/postgres ---
# Legacy POKESTUDIO_PI_DB_URL is still accepted; the new name takes precedence.
POKELAB_PI_DB_URL=

# --- Supabase Cloud "PokeStudio Dev" (project ref tofhupgwxsexrburoqys) — the
#     database behind the deployed Cloudflare Worker DEV environment, never
#     the Pi. Used only by scripts/db-cloud-dev-*.sh / ingest-cloud-dev.sh
#     (`pnpm db:cloud-dev:check` / `db:cloud-dev:migrate` / `ingest:cloud-dev`),
#     kept separate from the Pi/tooling variables above so neither can
#     silently overwrite the other. Never configured on the deployed web
#     Worker — that keeps using only NEXT_PUBLIC_SUPABASE_URL/
#     NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY set directly in Cloudflare.
#     Direct connection string from Supabase Dashboard → Project Settings →
#     Database → Connection string (URI). ---
SUPABASE_CLOUD_DEV_DB_URL=
SUPABASE_CLOUD_DEV_SECRET_KEY=

# --- Sentry (docs/engineering/OBSERVABILITY.md) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- AI providers (server-only; adapters live behind packages/ai when it exists) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
